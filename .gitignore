# ---------------------------------------------------------------------------
# macOS / editor cruft
# ---------------------------------------------------------------------------
.DS_Store
**/.DS_Store
.idea/
*.swp

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments (this repo's .venv is ~650 MB)
.venv/
venv/
env/

# ---------------------------------------------------------------------------
# Large data — raw / cached / preprocessed datasets
# Everything here is downloadable or regenerable; see README "Data & weights".
# ---------------------------------------------------------------------------
data/
**/data/
aclImdb/
aclImdb_v1.tar.gz

# Pickled / cached dataset dumps (CA3/imdb_mini.pkl is ~26 MB and is
# regenerated by the first cell of CA3/Challenge3.ipynb)
*.pkl
*.pickle
*.p
*.npy
*.npz

# ---------------------------------------------------------------------------
# Large model artifacts — trained weights and checkpoints
# ---------------------------------------------------------------------------
*.pth
*.pt
*.ckpt
*.h5
*.hdf5
*.keras
*.pb
*.tflite
*.onnx
*.safetensors
saved_models/
**/saved_models/
checkpoints/
runs/
wandb/
logs/
*.log

# Hugging Face / Keras / Torch download caches
.cache/
**/.cache/
transformers_cache/

# ---------------------------------------------------------------------------
# Generated media (MIDI renders produced by FinalProject)
# The reference .mid inputs under FinalProject/example1/midi_songs/ are the
# dataset and are intentionally NOT ignored.
# ---------------------------------------------------------------------------
FinalProject/MusicGenerator/*.mid
FinalProject/example2/*.mid
*.wav
*.mp3

# ---------------------------------------------------------------------------
# Keep: figures used by README.md
# ---------------------------------------------------------------------------
!assets/*.png

# ---------------------------------------------------------------------------
# Local-only directories (not tracked)
# ---------------------------------------------------------------------------
GAN/
RBM/
PDL/
